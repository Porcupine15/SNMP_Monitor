# PostgreSQL
DB_USER=snmp_user
DB_PASSWORD=change_this_password
DB_NAME=snmp_db

# Application security: generate a long random value before deployment.
ENVIRONMENT=production
SECRET_KEY=change_this_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Leave empty for same-origin access through the backend. For a separate UI,
# specify comma-separated HTTPS origins, e.g. https://snmp-monitor.example.internal
CORS_ORIGINS=
# Comma-separated CIDRs that the server is explicitly allowed to scan or poll.
ALLOWED_NETWORKS=10.20.0.0/16
# Comma-separated HTTP Host values. Replace with the corporate FQDN and VM IP.
TRUSTED_HOSTS=snmp-monitor.example.internal,10.20.0.10,localhost,127.0.0.1
APP_PORT=8000
TLS_BIND_ADDRESS=10.20.0.10
# Absolute paths on the server; required when compose.tls.yml is enabled.
TLS_CERT_PATH=/etc/snmp-monitor/tls/server.crt
TLS_KEY_PATH=/etc/snmp-monitor/tls/server.key

# Optional Telegram notifications. Keep empty until a bot/chat is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LAN_AGENT_TOKEN=change_to_a_long_random_token
# Keep disabled in production. Create the first admin with app.bootstrap_admin.
ALLOW_PUBLIC_REGISTRATION=false
