# PostgreSQL
DB_USER=snmp_user
DB_PASSWORD=change_this_password
DB_NAME=snmp_db

# Application security: generate a long random value before deployment.
SECRET_KEY=change_this_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Leave empty for same-origin access through the backend. For a separate UI,
# specify comma-separated origins, e.g. http://192.168.1.10:3000
CORS_ORIGINS=

# Optional Telegram notifications. Keep empty until a bot/chat is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LAN_AGENT_TOKEN=change_to_a_long_random_token
# Only the first account is public by default; admins create later accounts.
ALLOW_PUBLIC_REGISTRATION=false
